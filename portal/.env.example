# ===== Server =====
NODE_ENV=development
PORT=3004
LOG_LEVEL=warn

# ===== TLS (required when NODE_ENV=production) =====
# In production the server terminates HTTPS itself, reading this key/cert pair —
# same convention as auth-gateway. Ignored for every other NODE_ENV, so leave
# blank there.
SSL_KEY_PATH=
SSL_CERT_PATH=

# ===== OpenMRS schema (MySQL 5.7) — read-only =====
OPENMRS_DB_HOST=localhost
OPENMRS_DB_PORT=3306
OPENMRS_DB_NAME=openmrs
OPENMRS_DB_USER=elcg
OPENMRS_DB_PASSWORD=elcgpass

# ===== JWT (verify only — tokens are issued by auth-gateway) =====
# auth-gateway's PUBLIC key, never its private key. Resolved against the
# process cwd; in Docker this must be the in-container path (/app/keys/…).
# ISSUER/AUDIENCE must match auth-gateway's JWT_ISSUER/JWT_AUDIENCE.
JWT_ALGORITHM=RS256
JWT_PUBLIC_KEY_PATH=./keys/jwt-public.pem
JWT_ISSUER=elcg-auth-gateway
JWT_AUDIENCE=elcg-clients

# ===== CORS =====
CORS_ORIGIN=http://localhost:5173,http://localhost:8081
