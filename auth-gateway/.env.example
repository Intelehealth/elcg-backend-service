# ===== Server =====
NODE_ENV=development
PORT=3030
LOG_LEVEL=debug

# ===== Database (MySQL 5.7) — token store only =====
# Shares the existing mindmap_server schema with the legacy mindmap-api rather
# than standing up a new one. auth-gateway owns exactly two tables here
# (refresh_tokens, token_blacklist) and tracks them in SequelizeMetaAuthGateway.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mindmap_server
DB_USER=elcg
DB_PASSWORD=elcgpass

# ===== OpenMRS schema — identity source (users / provider / person) =====
# Host/port/user/password fall back to the DB_* values above when omitted,
# which is the usual case: both schemas on the same MySQL instance.
OPENMRS_DB_NAME=openmrs
# OPENMRS_DB_HOST=localhost
# OPENMRS_DB_PORT=3306
# OPENMRS_DB_USER=
# OPENMRS_DB_PASSWORD=

# ===== JWT (RS256 — store keys as base64 or path) =====
JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY_PATH=./keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=./keys/jwt-public.pem
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
JWT_ISSUER=elcg-auth-gateway
JWT_AUDIENCE=elcg-clients

# ===== OTP =====
OTP_LENGTH=6
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=3
OTP_RATE_LIMIT_PER_HOUR=5

# ===== SMS providers (Phase 1 — keys via GitHub Secrets / .env, NOT AWS Secrets Manager) =====
SMS_PROVIDER_INDIA=2factor
TWOFACTOR_API_KEY=
SMS_PROVIDER_INTL=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMS_PROVIDER_NEPAL=sparrow
SPARROW_API_TOKEN=

# ===== Rate limiting =====
LOGIN_LOCKOUT_ATTEMPTS=3
LOGIN_LOCKOUT_WINDOW_MIN=15

# ===== CORS =====
CORS_ORIGIN=http://localhost:5173,http://localhost:8081
